{
    "name": "internetdata-fastify",
    "version": "1.0.8",
    "description": "Official Fastify plugin for the InternetData API. Look up the visitor behind every request: location, network, VPN, proxy, Tor and hosting.",
    "type": "module",
    "packageManager": "pnpm@12.12.1",
    "license": "MIT",
    "homepage": "https://internetdata.io",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/internetdata/sdk-nodejs-fastify.git"
    },
    "bugs": {
        "url": "https://github.com/internetdata/sdk-nodejs-fastify/issues"
    },
    "keywords": [
        "fastify",
        "fastify-plugin",
        "middleware",
        "ip-geolocation",
        "ip-intelligence",
        "ip-lookup",
        "geoblocking",
        "vpn-detection",
        "proxy-detection",
        "tor",
        "hosting",
        "asn"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@internetdata/internetdata": "^2.16.0",
        "fastify-plugin": "^5.0.1"
    },
    "peerDependencies": {
        "fastify": "4.x || 5.x"
    },
    "devDependencies": {
        "@mslmio/eslint-config": "^1.1.0",
        "@types/node": "^26.2.0",
        "eslint": "^10.10.0",
        "fastify": "^5.6.1",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "build": "rm -rf dist && tsc",
        "lint": "eslint",
        "test": "pnpm run build && node --test test/*.test.mjs",
        "prepublishOnly": "pnpm run build"
    }
}
